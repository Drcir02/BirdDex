{
  "name": "birddex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BirdDex: a Pokédex for the birds of Czechia and Europe (installable web app).",
  "scripts": {
    "dev": "npm run vendor && vite",
    "vendor": "node scripts/copy-vendor.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
