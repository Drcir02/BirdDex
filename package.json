    "@litertjs/core": "^2.5.3",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "onnxruntime-web": "^1.30.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
